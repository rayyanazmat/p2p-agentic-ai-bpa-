# Copy this file to .env and fill in the values you need.
# The project intentionally keeps secrets in the environment, never in Git.

P2P_API_BASE_URL=http://127.0.0.1:8000
P2P_MODEL_PROVIDER=offline
P2P_MODEL_CALL_BUDGET=600
P2P_RUN_CASES=5
P2P_REQUEST_TIMEOUT=5
AGENT_MAX_TURNS=8

# Optional hosted model settings
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional local model settings
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREADS=2
