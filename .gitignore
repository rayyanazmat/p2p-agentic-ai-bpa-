# Downloaded BPI logs and generated processed data are not committed.
# The small, synthetic data/test_manifest_100.json fixture remains tracked.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated submission document
Phase1_AI4015_22P-0507.pdf

# Generated or hand-in-only binary exports; keep source files in submission/
*.pdf
*.zip
!submission/paper.pdf

# Generated LaTeX outputs and stale/compiled paper exports
submission/*.aux
submission/*.bbl
submission/*.blg
submission/*.log
submission/*.out
submission/paper.pdf
submission/DRAFT_STALE_*.pdf
submission/Phase2_AI4015_22P-0507_Paper.pdf
submission/Phase2_AI4015_22P-0507_Paper_source.zip

